# Backend and local infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=synapse
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=synapse

# Generate each value independently: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Browser origin permitted to call the Backend.
CORS_ORIGIN=http://localhost:5173

# Optional AI configuration; leaving the key empty keeps AI calls unavailable.
AI_PROVIDER=zai
ZAI_API_KEY=
