{
	"extends": "@monolyth/tsconfig/base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"jsx": "react-jsx",
		"noEmit": true,
		"experimentalDecorators": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"strictNullChecks": true,
		"types": ["bun"]
	},
	"include": [
		"src/vite-env.d.ts",
		"src/client",
		"src/entities",
		"src/features",
		"src/server",
		"src/shared",
		"src/widgets",
		"src/app/page.tsx",
		"src/app/dashboard/**/*.client.tsx",
		"src/app/dashboard/dashboard-content.tsx",
		"src/app/dashboard/graph/pageClient.tsx"
	],
	"exclude": ["node_modules"]
}
