{
	"name": "@synapse/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:install-tag-merge": "bun src/server/scripts/apply-tag-merge-db.ts",
		"db:set-god-mode": "bun src/server/scripts/apply-god-mode-existing.ts",
		"db:backfill-tag-colors": "bun src/server/scripts/backfill-tag-colors.ts",
		"db:studio": "drizzle-kit studio",
		"search:backfill": "bun src/server/scripts/backfill-search-text.ts",
		"format": "bun x oxfmt --config ../../.oxfmtrc.json --write .",
		"format:check": "bun x oxfmt --config ../../.oxfmtrc.json --check .",
		"lint": "bun x oxlint . --config ../../.oxlintrc.json --deny-warnings",
		"lint:fix": "bun x oxlint . --config ../../.oxlintrc.json --fix",
		"clean": "rm -rf dist node_modules",
		"dev": "bun run dev:server & bun run dev:client",
		"build": "bun run build:client",
		"start": "bun src/server/index.ts",
		"dev:client": "vite",
		"dev:server": "bun --watch src/server/index.ts",
		"build:client": "vite build",
		"api:dev": "bun --watch src/server/index.ts",
		"api:start": "bun src/server/index.ts",
		"test": "bun run test:server && bun run test:api",
		"test:server": "bun test src/server --path-ignore-patterns '**/*.integration.test.ts'",
		"test:api": "JWT_SECRET=test-access-secret JWT_REFRESH_SECRET=test-refresh-secret API_RATE_LIMIT_MUTATION=1000 bun test src/server --test-name-pattern 'API integration'",
		"test:coverage": "JWT_SECRET=test-access-secret JWT_REFRESH_SECRET=test-refresh-secret API_RATE_LIMIT_MUTATION=1000 bun test src/server --coverage --coverage-reporter=lcov --coverage-dir=../../coverage/server",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@scalar/hono-api-reference": "^0.11.12",
		"@synapse/core": "workspace:*",
		"@synapse/shared": "workspace:*",
		"@synapse/ui": "workspace:*",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.18",
		"@tiptap/core": "^3.27.0",
		"@tiptap/extension-code-block-lowlight": "^3.27.0",
		"@tiptap/extension-image": "^3.27.0",
		"@tiptap/extension-placeholder": "^3.27.0",
		"@tiptap/markdown": "^3.27.0",
		"@tiptap/react": "^3.27.0",
		"@tiptap/starter-kit": "^3.27.0",
		"@vitejs/plugin-react": "^6.0.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"dompurify": "^3.4.11",
		"drizzle-orm": "^0.45.2",
		"epub2": "^3.0.2",
		"framer-motion": "^12.40.0",
		"hono": "^4.12.34",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"lowlight": "^3.3.0",
		"lucide-react": "^1.21.0",
		"mammoth": "^1.12.0",
		"minio": "^8.0.7",
		"music-metadata": "^11.13.0",
		"next-themes": "^0.4.6",
		"papaparse": "^5.5.3",
		"pdfjs-dist": "^6.0.227",
		"pixi.js": "7.4.3",
		"postgres": "^3.4.9",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hot-toast": "^2.6.0",
		"react-masonry-css": "^1.0.16",
		"sharp": "^0.34.5",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.2.0",
		"xlsx": "^0.18.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@synapse/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/bun": "^1.3.14",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/lowlight": "^2.0.1",
		"@types/minio": "^7.1.1",
		"@types/node": "^24.13.2",
		"@types/papaparse": "^5.5.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"unrs-resolver"
	],
	"overrides": {
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2"
	}
}
