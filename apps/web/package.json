{
	"name": "@monolyth/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "bun x oxfmt --config ../../.oxfmtrc.json --write .",
		"format:check": "bun x oxfmt --config ../../.oxfmtrc.json --check .",
		"lint": "bun x oxlint . --config ../../.oxlintrc.json --deny-warnings",
		"lint:fix": "bun x oxlint . --config ../../.oxlintrc.json --fix",
		"clean": "rm -rf dist node_modules",
		"dev": "vite",
		"build": "bun run build:client",
		"dev:client": "vite",
		"build:client": "vite build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@monolyth/api": "workspace:*",
		"@monolyth/backend": "workspace:*",
		"@monolyth/core": "workspace:*",
		"@monolyth/features": "workspace:*",
		"@monolyth/i18n": "workspace:*",
		"@monolyth/shared": "workspace:*",
		"@monolyth/sync": "workspace:*",
		"@monolyth/ui": "workspace:*",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.18",
		"@tiptap/core": "^3.27.0",
		"@tiptap/extension-code-block-lowlight": "^3.27.0",
		"@tiptap/extension-image": "^3.27.0",
		"@tiptap/extension-placeholder": "^3.27.0",
		"@tiptap/markdown": "^3.27.0",
		"@tiptap/react": "^3.27.0",
		"@tiptap/starter-kit": "^3.27.0",
		"@vitejs/plugin-react": "^6.0.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"dompurify": "^3.4.11",
		"framer-motion": "^12.40.0",
		"hono": "^4.12.34",
		"lowlight": "^3.3.0",
		"lucide-react": "^1.21.0",
		"next-themes": "^0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hot-toast": "^2.6.0",
		"vite": "^8.2.0"
	},
	"devDependencies": {
		"@monolyth/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/bun": "^1.3.14",
		"@types/lowlight": "^2.0.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"unrs-resolver"
	]
}
