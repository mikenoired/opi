{
	"name": "@monolyth/desktop",
	"productName": "Monolyth",
	"description": "A personal knowledge hub for collecting, organizing, and connecting information.",
	"author": "Mike Noired",
	"copyright": "Copyright © 2026 Mike Noired",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./out/main/index.js",
	"build": {
		"appId": "com.monolyth.desktop",
		"productName": "Monolyth",
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
		"asar": true,
		"directories": {
			"buildResources": "resources",
			"output": "release"
		},
		"extraResources": [
			{
				"from": "resources/icon.png",
				"to": "icon.png"
			}
		],
		"mac": {
			"category": "public.app-category.productivity",
			"icon": "resources/icon.icns",
			"target": [
				"dmg",
				"zip"
			]
		},
		"dmg": {
			"icon": "resources/icon.icns"
		},
		"protocols": [
			{
				"name": "Monolyth",
				"schemes": [
					"monolyth"
				]
			}
		]
	},
	"scripts": {
		"build": "electron-vite build",
		"clean:release": "bun -e \"await import('node:fs/promises').then(({ rm }) => rm('release', { recursive: true, force: true }))\"",
		"dist": "bun run clean:release && electron-vite build && electron-builder",
		"dist:mac": "bun run clean:release && electron-vite build && electron-builder --mac",
		"icon:mac": "./scripts/png-to-icns.sh resources/icon.png resources/icon.icns",
		"dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
		"format": "bun x oxfmt --config ../../.oxfmtrc.json --write .",
		"format:check": "bun x oxfmt --config ../../.oxfmtrc.json --check .",
		"lint": "bun x oxlint . --config ../../.oxlintrc.json --deny-warnings",
		"preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
		"test": "bun test src --path-ignore-patterns '**/renderer/**'",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@monolyth/api": "workspace:*",
		"@monolyth/core": "workspace:*",
		"@monolyth/features": "workspace:*",
		"@monolyth/i18n": "workspace:*",
		"@monolyth/shared": "workspace:*",
		"@monolyth/sync": "workspace:*",
		"lucide-react": "^1.28.0",
		"music-metadata": "^11.13.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@monolyth/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"electron": "^43.3.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
