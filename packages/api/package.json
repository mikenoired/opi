		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@synapse/tsconfig": "workspace:*",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@synapse/shared": "workspace:*"
	}
}
