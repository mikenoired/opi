{
	"name": "@synapse/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"format": "bun x oxfmt --config ../../.oxfmtrc.json --write .",
