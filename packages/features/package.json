{
	"name": "@synapse/features",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./app-shell": "./src/app-shell.tsx",
		"./runtime": "./src/runtime/index.ts",
		"./styles.css": "./src/styles.css"
	},
	"scripts": {
		"format": "bun x oxfmt --config ../../.oxfmtrc.json --write .",
		"format:check": "bun x oxfmt --config ../../.oxfmtrc.json --check .",
