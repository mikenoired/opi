		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@monolyth/tsconfig": "workspace:*",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"happy-dom": "^20.11.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@monolyth/api": "workspace:*",
		"@monolyth/core": "workspace:*",
		"@monolyth/ui": "workspace:*",
		"@monolyth/shared": "workspace:*",
		"@monolyth/i18n": "workspace:*",
		"@tiptap/core": "^3.27.0",
		"@tiptap/extension-code-block-lowlight": "^3.27.0",
		"@tiptap/extension-image": "^3.27.0",
		"@tiptap/extension-list": "^3.27.0",
		"@tiptap/extension-placeholder": "^3.27.0",
		"@tiptap/markdown": "^3.27.0",
		"@tiptap/pm": "^3.27.0",
		"@tiptap/react": "^3.27.0",
		"@tiptap/starter-kit": "^3.27.0",
		"framer-motion": "^12.40.0",
		"lucide-react": "^1.21.0",
		"lowlight": "^3.3.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.8"
	}
