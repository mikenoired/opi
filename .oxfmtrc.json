{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "consistent",
	"sortImports": {},
	"sortPackageJson": false,
	"trailingComma": "es5",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": true,
	"bracketSpacing": true,
	"ignorePatterns": [
		"**/src/routeTree.gen.ts",
		"**/src/styles.css",
		"**/docs/performance/server-smoke.json",
		"**/dist",
		"**/build",
		"**/coverage"
	],
	"endOfLine": "lf",
	"jsxBracketSameLine": true,
	"sortTailwindcss": {
		"stylesheet": "./apps/web/src/app/globals.css",
		"functions": ["clsx", "cn"],
		"preserveWhitespace": true
	}
}
